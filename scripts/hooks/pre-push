#!/bin/sh
# A push to GitHub is refused when any commit being sent still contains
# a WINTEK directory, an AGENTS.md file, or an IMPLEMENTATION_PLAN.md
# file. Gitea remotes are unchanged.
remote_url=$2
printf '%s\n' "$remote_url" | grep -qi 'github.com' || exit 0

zero=0000000000000000000000000000000000000000

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "$local_sha" ] || continue
    [ "$local_sha" = "$zero" ] && continue

    if [ "$remote_sha" = "$zero" ]; then
        range=$local_sha
    else
        range=$remote_sha..$local_sha
    fi

    commits=$(git rev-list "$range" 2>/dev/null) || {
        echo "Refusing to push $local_ref to GitHub: cannot read $range" >&2
        exit 1
    }

    for c in $commits; do
        names=$(git ls-tree -r --name-only "$c") || {
            echo "Refusing to push $local_ref to GitHub: cannot read $c" >&2
            exit 1
        }
        if printf '%s\n' "$names" | grep -q -E '(^|/)WINTEK/'; then
            echo "Refusing to push $local_ref to $remote_url" >&2
            echo "WINTEK stays on Gitea and is not pushed to GitHub." >&2
            exit 1
        fi
        if printf '%s\n' "$names" | grep -q -i -E '(^|/)AGENTS\.md$'; then
            echo "Refusing to push $local_ref to $remote_url" >&2
            echo "AGENTS.md stays on Gitea and is not pushed to GitHub." >&2
            exit 1
        fi
        if printf '%s\n' "$names" | grep -q -i -E '(^|/)IMPLEMENTATION_PLAN\.md$'; then
            echo "Refusing to push $local_ref to $remote_url" >&2
            echo "IMPLEMENTATION_PLAN.md stays on Gitea and is not pushed to GitHub." >&2
            exit 1
        fi
    done
done

exit 0
